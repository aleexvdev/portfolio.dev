---
interface CardTrabajoProps {
  title: string;
  paragraph1: string;
  paragraph2: string;
  imageBase: string;
  imageAlt: string;
}

import Picture from "@/components/Picture.astro";

const { title, paragraph1, paragraph2, imageBase, imageAlt } =
  Astro.props as CardTrabajoProps;
---

<article class="group card-hover-effect relative overflow-hidden flex flex-col items-start justify-start col-span-1 row-span-2 md:col-span-2 md:row-span-3 lg:col-span-3 lg:row-span-3 rounded-3xl border border-gray-600/20 bg-[#181818] hover:bg-[#1f1f1f] transition-all duration-300">
  <div class="p-6 md:p-6 lg:p-8 w-full h-full pb-56 md:pb-72 lg:pb-80">
    <header class="w-full h-max flex items-start mb-6">
      <h2 class="title-animate text-3xl md:text-3xl lg:text-4xl font-semibold text-pretty text-white">
        {title}
      </h2>
    </header>

    <div class="w-full h-max flex flex-col items-start justify-start">
      <p class="text-base md:text-base lg:text-lg text-pretty leading-relaxed font-medium mb-5 text-white/75">
        {paragraph1}
      </p>
      <p class="text-base md:text-base lg:text-lg text-pretty leading-relaxed font-medium text-white/75">
        {paragraph2}
      </p>
    </div>

    <div
      class="absolute bottom-0 left-1/2 transform -translate-x-1/2 overflow-hidden w-[85%] md:w-[85%] lg:w-4/5 mx-auto h-auto shadow-2xl shadow-black/20 opacity-95 rounded-t-lg transition-transform duration-500 scale-105 hover:scale-110"
      style="mask-image: linear-gradient(black 90%, transparent);"
    >
      <Picture
        base={imageBase}
        alt={imageAlt}
        class="w-full h-full object-cover rounded-xl filter contrast-125 brightness-90 saturate-150 transition-all duration-500 hover:contrast-150 hover:brightness-100"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</article>

<style>
  .card-hover-effect {
    transition:
      transform 0.4s ease-in-out,
      box-shadow 0.4s ease-in-out,
      background 0.4s;
  }

  .card-hover-effect:hover {
    transform: scale(1.01);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  }

  .title-animate {
    transition: color 0.3s ease-in-out;
  }

  .group:hover .title-animate {
    color: #2563eb; /* Tailwind's blue-600 */
  }

  .icon-animate {
    transition:
      transform 0.3s ease,
      filter 0.3s ease;
  }

  .icon-animate:hover {
    transform: scale(1.1) rotate(2deg);
    filter: brightness(1.1);
  }
</style>