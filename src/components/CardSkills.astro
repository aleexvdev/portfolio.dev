---
interface Skill {
  skill: string;
  className: string;
}

interface CardHabilidadesProps {
  title: string;
  skills: Skill[];
}

const { title, skills } = Astro.props as CardHabilidadesProps;
---

<article
  class="group card-hover-effect relative col-span-1 row-span-1 flex flex-col items-center justify-center overflow-hidden rounded-3xl border border-gray-600/20 bg-[#e3e6e8] hover:bg-[#d7dadc] lg:col-span-1 lg:row-span-2 dark:bg-[#181818] dark:hover:bg-[#1f1f1f] transition-all duration-300"
>
  <div
    class="flex h-full w-full flex-col items-center justify-center p-6 md:p-6 lg:p-8"
  >
    <header class="mb-6 flex h-max w-full items-start">
      <h2
        class="title-animate text-3xl font-semibold text-pretty text-black md:text-3xl lg:text-4xl dark:text-white"
      >
        {title}
      </h2>
    </header>

    <div
      class="flex h-full w-full flex-col items-center justify-center gap-y-0 lg:gap-y-6"
    >
      <div
        class="flex h-full w-full flex-wrap items-center justify-center gap-1"
      >
        {
          skills.map(
            ({ skill, className = "bg-gray-200 text-gray-800" }, index) => (
              <div
                class={`flex h-fit w-fit items-center justify-center rounded-xl px-2 py-1 text-base font-medium transition-all duration-300 hover:scale-110 ${className}`}
              >
                {skill}
              </div>
            )
          )
        }
      </div>
    </div>
  </div>
</article>

<style>
  .card-hover-effect {
    transition:
      transform 0.4s ease-in-out,
      box-shadow 0.4s ease-in-out,
      background 0.4s;
  }

  .card-hover-effect:hover {
    transform: scale(1.015);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  }

  .title-animate {
    transition: color 0.3s ease-in-out;
  }

  .group:hover .title-animate {
    color: #2563eb;
  }
</style>
