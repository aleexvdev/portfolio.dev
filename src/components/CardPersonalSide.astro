---
interface CardPersonalProps {
  title: string;
  paragraphs: string[];
  icons: { src: string; alt: string }[];
}

const { title, paragraphs, icons } = Astro.props as CardPersonalProps;
---

<article
  class="group card-hover-effect relative col-span-1 row-span-2 flex flex-col items-center justify-start overflow-hidden rounded-3xl border border-gray-600/20 bg-[#e3e6e8] hover:bg-[#d7dadc] lg:col-span-2 lg:row-span-3 dark:bg-[#181818] dark:hover:bg-[#1f1f1f] transition-all duration-300"
>
  <div class="h-full w-full p-6 md:p-6 lg:p-8">
    <!-- Header with animated title -->
    <header class="mb-6 flex h-max w-full items-start">
      <h2
        class="title-animate text-3xl font-semibold text-pretty text-black md:text-3xl lg:text-4xl dark:text-white"
      >
        {title}
      </h2>
    </header>

    <!-- Paragraphs -->
    <div class="mb-14 h-max w-full flex-col items-start justify-start">
      {
        paragraphs.map((text) => (
          <p class="mb-5 text-base leading-relaxed font-medium text-pretty text-black/75 md:text-base lg:text-lg dark:text-white/75">
            {text}
          </p>
        ))
      }
    </div>

    <!-- Icons with animation -->
    <div class="flex h-max w-full items-center justify-between px-4 lg:px-10">
      {
        icons.map(({ src, alt }) => (
          <img
            src={src}
            alt={alt}
            loading="lazy"
            class="icon-animate h-14 w-14 object-contain lg:h-20 lg:w-20"
          />
        ))
      }
    </div>
  </div>
</article>

<style>
  .card-hover-effect {
    transition:
      transform 0.4s ease-in-out,
      box-shadow 0.4s ease-in-out,
      background 0.4s;
  }

  .card-hover-effect:hover {
    transform: scale(1.015);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  }

  .title-animate {
    transition: color 0.3s ease-in-out;
  }

  .group:hover .title-animate {
    color: #2563eb; /* Tailwind's blue-600 */
  }

  .icon-animate {
    transition:
      transform 0.3s ease,
      filter 0.3s ease;
  }

  .icon-animate:hover {
    transform: scale(1.1) rotate(2deg);
    filter: brightness(1.1);
  }
</style>
