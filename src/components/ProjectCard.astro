---
import Github from "@/assets/icons/github.astro";
import Picture from "@/components/Picture.astro";
import { useTranslations, type ui } from "@/i18n/i18n";
import type { Project } from "@/types/projects";
import { ExternalLink } from "lucide-react";

interface Props {
  project: Project;
  class?: string;
  lang: keyof typeof ui;
}

const { project, lang, class: className = "" } = Astro.props as Props;
const projectsT = useTranslations(lang)("projects");
---

<article
  class={`relative overflow-hidden rounded-xl md:rounded-3xl shadow-lg group ${className} select-none flex flex-col md:flex-row items-stretch gap-y-4 md:gap-x-4`}
>
  <Picture
    base={project.image}
    alt={project.title}
    class="h-56 w-full object-cover rounded-xl md:h-full md:min-h-[300px] md:w-1/2 md:rounded-3xl lg:min-h-[340px]"
  />
  <div
    class="w-full flex flex-col items-center justify-between gap-y-2 p-2 md:p-6 lg:p-8"
  >
    <div>
      <h3
        class="mb-3 text-2xl font-bold text-white transition-colors duration-300 group-hover:text-brand md:text-3xl text-start"
      >
        {project.title}
      </h3>
      <p
        class="mb-6 text-base leading-relaxed font-medium text-white transition-colors md:text-base"
      >
        {project.description[lang]}
      </p>
      {
        project.skills && project.skills.length > 0 && (
          <div class="mb-6 flex flex-wrap gap-2">
            {project.skills.map((tag) => (
              <span
                class={`rounded-lg bg-[#323233] px-3 py-1 text-xs font-medium shadow-sm transition-all duration-200 ${tag.color || "text-gray-200"}`}
              >
                {tag.name}
              </span>
            ))}
          </div>
        )
      }
    </div>
    <div class="mt-auto flex items-center justify-center gap-4">
      {
        project.repoLink && (
          <a
            href={project.repoLink}
            target="_blank"
            aria-label={projectsT.repoAriaLabel}
            rel="noopener noreferrer"
            class="group relative flex w-max cursor-pointer items-center justify-center space-x-1.5 rounded-lg bg-transparent p-3 transition-[color,background-color,transform] duration-150 active:scale-[0.97] md:space-x-2 text-white hover:bg-black hover:text-brand"
          >
            <Github className="text-white" width="24" height="24" />
            <span class="relative text-base font-medium md:text-lg">
              {projectsT.viewRepo}
              <span class="absolute -bottom-0.5 left-0 h-0.5 w-0 bg-brand-deep transition-all duration-150 group-hover:w-full" />
            </span>
          </a>
        )
      } 
      {
        project.viewLink && (
          <a
            href={project.viewLink}
            target="_blank"
            aria-label={projectsT.demoAriaLabel}
            rel="noopener noreferrer"
            class="group relative flex w-max cursor-pointer items-center justify-center space-x-1.5 rounded-lg bg-transparent p-3 transition-[color,background-color,transform] duration-150 active:scale-[0.97] md:space-x-2 text-white hover:bg-black hover:text-brand"
          >
            <span class="relative text-base font-medium md:text-lg">
              {projectsT.demo}
              <span class="absolute -bottom-0.5 left-0 h-0.5 w-0 bg-brand-deep transition-all duration-150 group-hover:w-full" />
            </span>
            <ExternalLink width="24" height="24" />
          </a>
        )
      }
    </div>
  </div>
</article>