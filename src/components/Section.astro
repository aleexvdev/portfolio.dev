---
interface SectionProps {
  title: string;
  eyebrow?: string;
  icon: any;
  id: string;
  className?: string;
  minHeight?: string;
}

const {
  title,
  eyebrow,
  icon: Icon,
  id,
  className = "",
  minHeight = "min-h-screen",
} = Astro.props as SectionProps;

const sectionEyebrow = eyebrow ?? id;
---

<section
  id={id}
  aria-labelledby={`${id}-label`}
  class={`relative flex w-full ${minHeight} flex-col items-center justify-start overflow-hidden px-6 pt-24 md:pt-28 lg:pt-32 max-w-7xl mx-auto`}
>
  <div class={`absolute inset-0 ${className}`}></div>
  <div class="flex w-full max-w-7xl flex-col gap-6 opacity-0 animate-fade-in">
    <div class="flex flex-col gap-2">
      <p
        class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-muted md:text-sm"
      >
        {sectionEyebrow}
      </p>
      <h2
        id={`${id}-label`}
        class="text-pretty break-words text-3xl font-bold text-white md:text-4xl lg:text-5xl animate-fade-in-up"
      >
        {title}
      </h2>
    </div>
    <div class="animate-fade-in-up delay-[300ms] w-full">
      <slot />
    </div>
  </div>
</section>

<style is:global>
  @layer utilities {
    @keyframes icon-pop {
      0% {
        transform: scale(0) rotate(-180deg);
        opacity: 0;
      }
      100% {
        transform: scale(1) rotate(0);
        opacity: 1;
      }
    }

    @keyframes fade-in-up {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fade-in {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    .animate-icon-pop {
      animation: icon-pop 0.5s var(--ease-out) forwards;
      animation-delay: 0.3s;
    }

    .animate-fade-in-up {
      animation: fade-in-up 0.5s var(--ease-out) forwards;
      animation-delay: 0.4s;
    }

    .animate-fade-in {
      animation: fade-in 0.5s var(--ease-out) forwards;
      animation-delay: 0.2s;
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-icon-pop,
      .animate-fade-in-up,
      .animate-fade-in {
        animation: none;
        opacity: 1;
      }
    }
  }
</style>
