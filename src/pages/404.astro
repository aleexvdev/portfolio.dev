---
import ErrorPage from "@/layouts/error-page.astro";

const title = "Alexander Valverde | Ingeniero Informático";
const description =
  "Hola! Soy Alexander Valverde, un ingeniero informático especializado en desarrollo de software y programación web. Estoy comprometido con la creación de soluciones innovadoras y útiles para mejorar la experiencia de los usuarios. Hábil tanto en frontend como en backend.";
const canonicalPathname = "https://alexvdev.netlify.app";
const logo = "{av.}";
---

<ErrorPage
  title={title}
  description={description}
  canonicalPathname={canonicalPathname}
>
  <header class="fixed z-[99999] h-max w-full transition-colors duration-300">
    <div
      class="relative mx-auto flex h-full w-full max-w-screen-lg justify-center"
    >
      <div
        class="flex h-max w-full items-center justify-between rounded-3xl px-6 py-1 transition-all duration-300 md:py-3"
      >
        <div class="flex h-max w-max items-center">
          <a
            href="/#"
            class="gradient-text flex flex-col items-center justify-center text-2xl leading-6 font-bold transition-transform duration-200 select-none lg:text-3xl"
            style={{
              background:
                "linear-gradient(90deg, #9845e8 0%, #3377ff 55%, #dd5789 100%)",
              WebkitBackgroundClip: "text",
              WebkitTextFillColor: "transparent",
            }}
          >
            {logo}
          </a>
        </div>
      </div>
    </div>
  </header>
  <main
    class="relative mx-auto flex min-h-screen w-full max-w-screen-lg flex-col items-center justify-center"
  >
    <img
      src="./thinking-face.png"
      alt="404: Página no encontrada"
      class="animate-float mb-5"
    />
    <h1 class="mb-5 text-6xl font-bold text-black/80 dark:text-white/80">
      Hmmm...
    </h1>
    <p class="text-2xl font-bold text-black/80 dark:text-white/80">
      Parece que aquí no hay nada.
    </p>
    <p class="mt-1 text-2xl font-bold text-black/80 dark:text-white/80">
      <span>Quizás deberías volver a</span>
      <a
        href="/#"
        class="group relative inline-block rounded font-bold text-blue-700 transition duration-300 ease-in-out hover:text-blue-700"
      >
        casa
        <span
          class="absolute bottom-0 left-0 h-0.5 w-0 bg-blue-700 transition-all duration-300 ease-in-out group-hover:w-full"
        ></span>
      </a>.
    </p>
  </main>
</ErrorPage>

<style>
  @keyframes float {
    0% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
    100% {
      transform: translateY(0px);
    }
  }

  img {
    max-width: 100%;
    vertical-align: middle;
  }
  .animate-float {
    animation: float 3s ease-in-out infinite;
  }
</style>
