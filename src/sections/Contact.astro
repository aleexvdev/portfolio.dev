---
import Section from "@/components/Section.astro";
import MailCheck from "@/assets/icons/mail-check.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/i18n";
import AtSign from "@/assets/icons/at-sign.astro";
import UserCheck from "@/assets/icons/user-round-check.astro";
import Message from "@/assets/icons/messages-square.astro";
import Linkedin from "@/assets/icons/linkedin.astro";
import CardSocialContact from "@/components/CardSocialContact.astro";
import Discord from "@/assets/icons/discord.astro";
import Facebook from "@/assets/icons/facebook.astro";
import Mail from "@/assets/icons/mail.astro";
import Gmail from "@/assets/icons/gmail.astro";
import Instagram from "@/assets/icons/instagram.astro";
import { TurnstileWidget } from "@/components/react/TurnstileWidget";
import RefreshCcw from "@/assets/icons/refresh-ccw.astro";
import { Toast } from "@/components/react/Toast";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const contact = t("contact");
const title = contact.title;
const heading = contact.heading;
const description = contact.description;
const form = contact.form;
const thanks = contact.thanks;
const connect = contact.connect;
const equationIdea = contact.equationIdea;
const equationExperience = contact.equationExperience;
const equationEquals = contact.equationEquals;

const contactMethods = [
  {
    icon: Gmail,
    label: "Correo electrónico",
    value: "alexvalverde.dev@gamil.com",
    href: "mailto:alexvalverde.dev@gamil.com",
    color: "from-neutral-700 to-neutral-600",
    labelColor: "text-red-600",
  },
  {
    icon: Linkedin,
    label: "LinkedIn",
    value: "linkedin.com/in/alexvdev",
    href: "https://www.linkedin.com/in/alexvdev/",
    color: "from-sky-600 to-sky-700",
    labelColor: "text-sky-700",
  },
  {
    icon: Discord,
    label: "Discord",
    value: "alexvdev#6865",
    href: "https://discordapp.com/users/550184376441503744",
    color: "from-indigo-400 to-indigo-600",
    labelColor: "text-indigo-500",
  },
  {
    icon: Facebook,
    label: "Facebook",
    value: "facebook.com/alexvalverde666",
    href: "https://www.facebook.com/alexvalverde666",
    color: "from-blue-600 to-blue-700",
    labelColor: "text-blue-700",
  },
  {
    icon: Instagram,
    label: "Instagram",
    value: "instagram.com/alexvalverde._",
    href: "https://www.instagram.com/alexvalverde._/",
    color: "from-neutral-700 to-gray-600",
    labelColor: "text-pink-600",
  },
];
---

<Section title={title} icon={MailCheck} id="contact" order={4}>
  <div
    class="mt-6 mb-8 flex h-full w-full flex-col items-start justify-between lg:flex-row"
  >
    <div
      class="group relative mb-8 w-full rounded-2xl border border-white/10 bg-zinc-800/40 p-8 shadow-2xl backdrop-blur-xl transition-all duration-500 hover:shadow-blue-500/20"
    >
      <div class="absolute top-4 left-4 flex space-x-2">
        <span class="h-3 w-3 rounded-full bg-red-500"></span>
        <span class="h-3 w-3 rounded-full bg-yellow-400"></span>
        <span class="h-3 w-3 rounded-full bg-green-500"></span>
      </div>
      <div class="mb-8 text-center">
        <h2
          class="mt-4 text-3xl font-semibold text-pretty text-white md:text-4xl lg:mt-2"
        >
          {heading}
        </h2>
        <p
          class="mt-2.5 w-full text-center text-base leading-relaxed font-medium text-pretty text-white/75 md:text-lg"
        >
          {description}
        </p>
      </div>
      <form
        id="contact-form"
        class="space-y-6"
        data-form-translations={JSON.stringify(form)}
      >
        <div class="group relative">
          <label
            for="email"
            class="mb-1 flex items-center gap-2 text-lg font-medium text-gray-300"
          >
            <AtSign
              class="text-blue-400 transition group-hover:scale-110"
              width="20"
              height="20"
            />
            {form.email}
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder={form.emailPlaceholder}
            class="mt-2 w-full rounded-lg bg-white/10 px-4 py-3 backdrop-blur-md transition placeholder:font-normal placeholder:text-stone-400/65 focus:ring-2 focus:ring-transparent focus:outline-none"
          />
          <p id="email-error" class="mt-1 text-sm text-red-500"></p>
        </div>
        <div class="group relative">
          <label
            for="name"
            class="mb-1 flex items-center gap-2 text-base font-medium text-gray-300"
          >
            <UserCheck
              class="text-blue-400 transition group-hover:scale-110"
              width="20"
              height="20"
            />
            {form.name}
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder={form.namePlaceholder}
            class="mt-2 w-full rounded-lg bg-white/10 px-4 py-3 backdrop-blur-md transition placeholder:font-normal placeholder:text-stone-400/65 focus:ring-2 focus:ring-transparent focus:outline-none"
          />
          <p id="name-error" class="mt-1 text-sm text-red-500"></p>
        </div>
        <div class="group relative">
          <label
            for="subject"
            class="mb-1 flex items-center gap-2 text-base font-medium text-gray-300"
          >
            <Mail
              class="text-blue-400 transition group-hover:scale-110"
              width="20"
              height="20"
            />
            {form.subject}
          </label>
          <input
            type="text"
            id="subject"
            name="subject"
            required
            placeholder={form.subjectPlaceholder}
            class="mt-2 w-full rounded-lg bg-white/10 px-4 py-3 backdrop-blur-md transition placeholder:font-normal placeholder:text-stone-400/65 focus:ring-2 focus:ring-transparent focus:outline-none"
          />
          <p id="subject-error" class="mt-1 text-sm text-red-500"></p>
        </div>
        <div class="group relative">
          <label
            for="message"
            class="mb-1 flex items-center gap-2 text-base font-medium text-gray-300"
          >
            <Message
              class="text-blue-400 transition group-hover:scale-110"
              width="20"
              height="20"
            />
            {form.message}
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            placeholder={form.messagePlaceholder}
            class="mt-2 w-full resize-none rounded-lg bg-white/10 px-4 py-3 backdrop-blur-md transition placeholder:font-normal placeholder:text-stone-400/65 focus:ring-2 focus:ring-transparent focus:outline-none"
          ></textarea>
          <p id="message-error" class="mt-1 text-sm text-red-500"></p>
        </div>
        <div class="flex justify-center w-full">
          <TurnstileWidget
            client:load
            onVerify={(token) => (window as any).setTurnstileToken(token)}
          />
        </div>
        <div class="py-2 text-center md:text-end flex flex-col md:flex-row items-center justify-center gap-2 w-full">
          <button
            id="reset-btn"
            type="button"
            class="cursor-pointer w-full rounded-xl bg-gradient-to-r from-gray-500 to-gray-600 px-4 py-2 flex items-center justify-center gap-x-2 font-semibold text-white shadow-lg transition hover:from-gray-600 hover:to-gray-700 hover:shadow-xl focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 focus:outline-none md:w-full"
          >
            <RefreshCcw class="mr-2 inline-block" width="20" height="20" />
            {form.reset}
          </button>
          <button
            id="submit-btn"
            type="submit"
            class="cursor-pointer w-full rounded-xl bg-gradient-to-r from-blue-500 to-indigo-600 px-4 py-2 font-semibold text-white shadow-lg transition hover:from-blue-600 hover:to-indigo-700 hover:shadow-xl focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:outline-none md:w-full"
          >
            🚀 {form.submit}
          </button>
        </div>
      </form>
      <div class="mt-4 text-center text-sm font-semibold text-gray-400">
        <span>{form.privacy}</span>
      </div>
    </div>
    <div
      class="mt-6 flex h-full w-full flex-col items-center justify-center overflow-hidden transition-all duration-300 md:pl-4 lg:mt-10"
    >
      <header
        class="mb-4 w-full text-center text-3xl font-semibold text-pretty text-white md:text-4xl"
      >
        {thanks}
      </header>
      <p
        class="w-full text-center text-base leading-relaxed font-medium text-pretty text-white/75 md:text-lg"
      >
        {connect}
      </p>
      <p
        class="mb-6 w-full text-center text-base leading-relaxed font-medium text-pretty text-white/75 md:mb-10 md:text-lg"
      >
        {equationIdea}{" "}<span class="text-green-600">+</span>{" "}{
          equationExperience
        }{" "}<span class="text-green-600">=</span>{" "}{equationEquals}
      </p>
      <div
        class="mb-8 grid h-full w-full grid-cols-1 items-center space-y-6 px-0 md:px-6"
      >
        {
          contactMethods.map((method, index) => (
            <CardSocialContact
              method={method}
              label={method.label}
              value={method.value}
              color={method.color}
              icon={method.icon}
            />
          ))
        }
      </div>
    </div>
  </div>
</Section>

<Toast client:load type="" message="" isVisible={false} />

<style>
  input,
  textarea {
    text-decoration: none;
    border: none;
    background: transparent;
    outline: none;
    width: 100%;
    font-size: 18px;
    font-weight: 400;
    color: #3e3e3d;
  }

  /* Autofill fix */
  input:-webkit-autofill,
  input:-webkit-autofill:hover,
  input:-webkit-autofill:focus {
    box-shadow: 0 0 0px 1000px transparent inset !important;
    -webkit-box-shadow: 0 0 0px 1000px transparent inset !important;
    -webkit-text-fill-color: #57534e !important;
    transition: background-color 5000s ease-in-out 0s;
  }

  .form-label {
    width: 12rem;
    min-width: 12rem;
    flex-shrink: 0;
  }

  .form-row {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid rgba(79, 85, 94, 0.2);
    padding-bottom: 0.25rem;
  }

  .form-row textarea {
    min-height: 20rem;
    resize: none;
    border-radius: 0.75rem;
    background-color: rgba(255, 255, 255, 0.5);
    padding: 1rem;
    font-weight: 400;
    box-shadow: 0 10px 15px -3px rgba(255, 255, 255, 0.1);
  }

  @media (prefers-color-scheme: dark) {
    input,
    textarea {
      color: #a7a5a4;
    }

    .form-row textarea {
      background-color: #000000;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
    }

    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus {
      -webkit-text-fill-color: #a8a29e !important;
    }
  }
</style>

<script>
  import * as yup from "yup";
  import { schema } from "@/lib/middleware";

  // Toast state management
  let toastVisible = false;
  let toastType = "";
  let toastMessage = "";

  function showToast(message: string, type: 'success' | 'error' = 'success') {
    toastMessage = message;
    toastType = type;
    toastVisible = true;
    
    // Dispatch custom event to update toast
    window.dispatchEvent(new CustomEvent('updateToast', {
      detail: { message, type, isVisible: true }
    }));

    // Hide toast after 5 seconds
    setTimeout(() => {
      toastVisible = false;
      window.dispatchEvent(new CustomEvent('updateToast', {
        detail: { message: '', type: '', isVisible: false }
      }));
    }, 5000);
  }

  function initializeForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
    const resetBtn = document.getElementById("reset-btn") as HTMLButtonElement;
    
    if (!form || !submitBtn || !resetBtn) {
      console.error("Form elements not found");
      return;
    }

    const translations = JSON.parse(form.dataset.formTranslations || "{}");
    let turnstileToken: string | null = null;

    (window as any).setTurnstileToken = (token: string) => {
      turnstileToken = token;
      console.log("Turnstile token set:", token);
    };
    
    const resetForm = () => {
      form.reset();
      turnstileToken = null;
      document.getElementById("email-error")!.textContent = "";
      document.getElementById("name-error")!.textContent = "";
      document.getElementById("subject-error")!.textContent = "";
      document.getElementById("message-error")!.textContent = "";
      if (window.turnstile) {
        window.turnstile.reset();
      }
      submitBtn.disabled = false;
      submitBtn.innerHTML = `🚀 ${translations.submit}`;
    };

    resetBtn.addEventListener("click", resetForm);

    form.addEventListener("submit", async (e) => {
      console.log("Form submit event triggered");
      e.preventDefault();
      e.stopPropagation();
      
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());
      console.log("Form data:", data);

      try {
        await schema.validate(data, { abortEarly: false });
        
        document.getElementById("email-error")!.textContent = "";
        document.getElementById("name-error")!.textContent = "";
        document.getElementById("subject-error")!.textContent = "";
        document.getElementById("message-error")!.textContent = "";

        if (!turnstileToken) {
          showToast("Por favor completa la verificación de Turnstile.", "error");
          return;
        }
        
        submitBtn.disabled = true;
        submitBtn.innerHTML = translations.sending;
        console.log("Sending email...");

        const response = await fetch("/api/send-email", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            ...data,
            turnstileToken,
          }),
        });

        console.log("Response status:", response.status);

        if (response.ok) {
          showToast("¡Mensaje enviado exitosamente!", "success");
          resetForm();
        } else {
          const errorData = await response.json();
          showToast(`Error al enviar el mensaje: ${errorData.error}`, "error");
        }
      } catch (error) {
        console.error("Form submission error:", error);
        if (error instanceof yup.ValidationError) {
          error.inner.forEach((err) => {
            const errorElement = document.getElementById(`${err.path}-error`);
            if (errorElement) {
              errorElement.textContent = err.message;
            }
          });
          showToast("Por favor corrige los errores en el formulario.", "error");
        } else {
          showToast("Error inesperado. Intenta nuevamente.", "error");
        }
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `🚀 ${translations.submit}`;
      }
    });
  }

  // Try multiple ways to initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeForm);
  } else {
    initializeForm();
  }

  // Also try astro:page-load as backup
  document.addEventListener("astro:page-load", initializeForm);
</script>
