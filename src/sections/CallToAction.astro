---
import Linkedin from "@/assets/icons/linkedin.astro";
import Mail from "@/assets/icons/mail.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/i18n";
import { ArrowRight, Coffee } from "lucide-react";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const cta = t("cta");
const available = cta.available;
const idea = cta.idea;
const makeReal = cta.makeReal;
const description = cta.description;
const closing = cta.closing;
const linkedin = cta.linkedin;
const contact = cta.contact;
---

<div
  id="cta-section"
  class="cta-section relative mt-8 flex flex-col items-center justify-center overflow-hidden px-4 py-20"
>
  <div
    class="relative z-10 mx-auto max-w-4xl px-4 text-center text-white sm:px-6 lg:px-8"
  >
    <div class="mb-6 flex justify-center">
      <div
        class="flex items-center space-x-3 rounded-2xl border border-white/20 bg-white/10 px-4 py-2 shadow-md backdrop-blur-md"
      >
        <Coffee className="animate-float h-8 w-8 text-amber-400" />
        <span class="text-base font-medium md:text-lg">{available}</span>
      </div>
    </div>

    <h2
      class="flex flex-col items-center justify-center text-4xl font-extrabold md:text-6xl"
    >
      <span class="text-white drop-shadow-md">{idea}</span>
      <span
        class="shimmer-text bg-gradient-to-r from-brand-muted via-brand to-brand-highlight bg-clip-text pb-2 leading-[1.15] text-transparent drop-shadow-md"
        >{makeReal}</span
      >
    </h2>
    <p class="my-8 max-w-3xl text-2xl leading-relaxed text-gray-300 md:text-3xl">
      {description}
    </p>
    <p class="mb-8 max-w-3xl text-2xl leading-relaxed font-medium text-brand-muted md:text-3xl">
      {closing}
    </p>
    <div
      class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row"
    >
      <a
        href="mailto:alexvalverde.dev@gmail.com"
        class="cta-btn cta-btn-primary group flex w-full items-center justify-center gap-3 rounded-xl bg-gradient-to-br from-brand to-brand-deep px-8 py-3.5 text-lg font-semibold text-white shadow-lg active:scale-[0.97] sm:w-auto"
      >
        <Mail class="text-white" width="24" height="24" />
        <span>{contact}</span>
        <ArrowRight className="cta-btn-arrow h-5 w-5" />
      </a>
      <a
        href="https://www.linkedin.com/in/alexvdev/"
        target="_blank"
        rel="noopener noreferrer"
        class="cta-btn cta-btn-secondary group flex w-full items-center justify-center gap-3 rounded-xl border border-white/20 bg-white/5 px-8 py-3.5 text-lg font-semibold text-white shadow-lg backdrop-blur-sm active:scale-[0.97] sm:w-auto"
      >
        <Linkedin class="text-white" width="24" height="24" />
        <span>{linkedin}</span>
        <ArrowRight className="cta-btn-arrow h-5 w-5" />
      </a>
    </div>
  </div>
</div>

<style>
  .cta-section {
    background: radial-gradient(ellipse at bottom, #05080c 0%, #000 80%);
  }

  .cta-section::before,
  .cta-section::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cta-section::before {
    background-image:
      radial-gradient(1px 1px at 20px 30px, rgba(255, 255, 255, 0.7), transparent),
      radial-gradient(1px 1px at 80px 120px, rgba(255, 255, 255, 0.5), transparent),
      radial-gradient(1.5px 1.5px at 160px 60px, rgba(255, 255, 255, 0.6), transparent),
      radial-gradient(1px 1px at 240px 180px, rgba(255, 255, 255, 0.4), transparent),
      radial-gradient(1px 1px at 320px 90px, rgba(255, 255, 255, 0.55), transparent),
      radial-gradient(1.5px 1.5px at 420px 140px, rgba(255, 255, 255, 0.45), transparent),
      radial-gradient(1px 1px at 520px 40px, rgba(255, 255, 255, 0.65), transparent),
      radial-gradient(1px 1px at 640px 200px, rgba(255, 255, 255, 0.35), transparent);
    background-size: 700px 220px;
    animation: star-twinkle 6s ease-in-out infinite alternate;
  }

  .cta-section::after {
    background: linear-gradient(
      115deg,
      transparent 40%,
      rgba(59, 130, 246, 0.08) 50%,
      transparent 60%
    );
    animation: meteor-pass 12s linear infinite;
  }

  @keyframes star-twinkle {
    from {
      opacity: 0.55;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes meteor-pass {
    from {
      transform: translateX(-30%) translateY(-10%);
      opacity: 0;
    }
    10% {
      opacity: 0.6;
    }
    20% {
      transform: translateX(30%) translateY(20%);
      opacity: 0;
    }
    100% {
      transform: translateX(30%) translateY(20%);
      opacity: 0;
    }
  }

  .cta-btn {
    transition:
      transform 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out),
      border-color 0.45s var(--ease-out),
      background-color 0.45s var(--ease-out);
  }

  .cta-btn-arrow {
    transition: transform 0.45s var(--ease-out);
  }

  @media (hover: hover) {
    .cta-btn:hover {
      transform: scale(1.03);
    }

    .cta-btn:hover .cta-btn-arrow {
      transform: translateX(4px);
    }

    .cta-btn-primary:hover {
      box-shadow:
        0 4px 20px oklch(0.78 0.12 175 / 0.35),
        0 0 28px oklch(0.78 0.12 175 / 0.2);
    }

    .cta-btn-secondary:hover {
      border-color: oklch(0.78 0.12 175 / 0.4);
      background-color: oklch(0.78 0.12 175 / 0.1);
      box-shadow:
        0 4px 16px oklch(0.78 0.12 175 / 0.15),
        0 0 24px oklch(0.78 0.12 175 / 0.12);
    }
  }

  @keyframes floatPulse {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  .animate-float {
    animation: floatPulse 3s ease-in-out infinite;
  }

  @keyframes shimmer {
    0% {
      background-position: -200% center;
    }
    100% {
      background-position: 200% center;
    }
  }

  .shimmer-text {
    background-size: 400% auto;
    animation: shimmer 6s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-section::before,
    .cta-section::after,
    .animate-float,
    .shimmer-text {
      animation: none;
    }

    .cta-section::before {
      opacity: 0.8;
    }

    .cta-btn,
    .cta-btn-arrow {
      transition: none !important;
    }

    .cta-btn:hover,
    .cta-btn:hover .cta-btn-arrow {
      transform: none !important;
    }
  }
</style>
