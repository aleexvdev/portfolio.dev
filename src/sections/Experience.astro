---
import Section from "@/components/Section.astro";
import BriefcaseBusiness from "@/assets/icons/briefcaseBusiness.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/i18n";
import { experiences } from "@/data/experiences";
import { ExperienceCard } from "@/components/react/ExperienceCard";
import { localizeExperience } from "@/lib/experience";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const experience = t("experience");
const nav = t("nav");
const title = experience.title;
const achievements = experience.achievements;
const responsibilities = experience.responsibilities;
const skills = experience.skills;
const eyebrow = nav.experience.label;
---

<Section
  title={title}
  eyebrow={eyebrow}
  icon={BriefcaseBusiness}
  id="experience"
  minHeight="min-h-max"
>
  <div class="mt-6 space-y-8 pb-8">
    {
      experiences.map((item) => (
        <ExperienceCard
          experience={localizeExperience(item, lang)}
          titleAchievements={
            item.company === "Freelance" ? responsibilities : achievements
          }
          titleSkills={skills}
          client:only="react"
        />
      ))
    }
  </div>
</Section>