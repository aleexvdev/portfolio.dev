---
import Section from "@/components/Section.astro";
import AboutMe from "@/assets/icons/user-round.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/i18n";
import CardProfile from "@/components/CardProfile.astro";
import CardPersonalSide from "@/components/CardPersonalSide.astro";
import CardSkills from "@/components/CardSkills.astro";
import CardEducation from "@/components/CardEducacion.astro";
import CardWork from "@/components/CardWork.astro";
import CardLocation from "@/components/CardLocation.astro";
import { skills } from "@/data/data";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const about = t("about");
const nav = t("nav");
const title = about.title;
const profile = about.profile;
const personal = about.personal;
const skillsTitle = about.skills;
const work = about.work;
const education = about.education;
const location = about.location;
const now = new Date();
const hours = now.getHours();
const minutes = now.getMinutes();
const currentDate = now.toLocaleDateString("es-PE", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Section title={title} eyebrow={nav.about.label} icon={AboutMe} id="about" minHeight="h-max">
  <div
    class="mt-6 mb-8 grid h-full w-full grid-flow-row grid-cols-1 gap-y-4 p-0 md:grid-cols-2 md:gap-4 lg:grid-cols-3 lg:grid-rows-6 select-none"
  >
    <CardProfile
      name="Ing. Alexander Valverde"
      username="@aleexvdev"
      image="/about-images/profile.webp"
      status={profile.status}
      quote={profile.quote}
    />
    <CardPersonalSide
      title={personal.title}
      paragraphs={personal.paragraphs}
      icons={[
        { src: "/about-images/soccer.png", alt: "Soccer" },
        { src: "/about-images/dog.png", alt: "Perrito" },
        { src: "/about-images/pasta.png", alt: "Pasta" },
        { src: "/about-images/joystick.png", alt: "Joystick" },
      ]}
    />
    <CardSkills title={skillsTitle.title} skills={skills} />
    <CardWork
      title={work.title}
      paragraph1={work.paragraphs[0]}
      paragraph2={work.paragraphs[1]}
      imageSrc="/about-images/method_work.png"
      imageAlt="Mi método de trabajo"
    />
    <CardEducation
      title={education.title}
      degree={education.degree}
      location="Lima, Perú"
      years="2016 - 2021"
      description={education.description}
    />
    <CardLocation
      location={location.location}
      country="Perú"
      flagSrc="/about-images/bandera.png"
      timeDifference={location.timeDifference}
      hours={hours}
      minutes={minutes}
      utcOffset="UTC-5"
      currentDate={currentDate}
      title={location.title}
    />
  </div>
</Section>