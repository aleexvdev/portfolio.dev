---
import Header from "@/components/Header.astro";
import { getLangFromUrl } from "@/i18n/i18n";
import "@/styles/global.css";
import { ScrollUp } from "@/components/react/ScrollUp";
import Seo from "@/layouts/seo.astro";

const lang = getLangFromUrl(Astro.url);
const { title, description, canonicalPathname } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Seo
      title={title}
      description={description}
      canonicalPathname={canonicalPathname}
      lang={lang}
      includeJsonLd={canonicalPathname === "/" || canonicalPathname === "/en"}
    />
    <link rel="manifest" href="/manifest.json" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="msapplication-TileColor" content="#353535" />
    <meta name="theme-color" content="#353535" />
  </head>
  <body class="bg-background relative w-screen overflow-x-hidden">
    <div
      class="bg-background absolute top-0 z-[-2] h-screen w-screen bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"
    >
    </div>
    <Header />
    <slot />
    <ScrollUp client:load />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100vh;
    overflow-x: hidden;
    overflow-y: auto;
    box-sizing: border-box;
    scroll-behavior: smooth;
    font-family: "Onest Variable", system-ui, sans-serif;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  #nav {
    animation: blur linear both 0.5s;
    animation-timeline: scroll();
    animation-range: 0 500px;
  }
</style>
