---
import {
  getAlternatePathnames,
  getPersonJsonLd,
  toAbsoluteUrl,
} from "@/lib/seo";

type Props = {
  title: string;
  description: string;
  canonicalPathname: string;
  lang?: "es" | "en";
  alternateLocales?: boolean;
  includeJsonLd?: boolean;
  noindex?: boolean;
  nofollow?: boolean;
};

const {
  title,
  description,
  canonicalPathname,
  lang = "es",
  alternateLocales = true,
  includeJsonLd = false,
  noindex = false,
  nofollow = false,
} = Astro.props;

const cleanTitle = title.trim();
const cleanDescription = description.replace(/\s+/g, " ").trim();
const canonicalURL = toAbsoluteUrl(canonicalPathname, Astro.site);

const keywords =
  "desarrollo de software, programación web, ingeniero informático, Php, Laravel, Node.js, React, Full Stack, aplicaciones web, SEO, programador web, JavaScript, tecnologías web";

const imageAltText =
  lang === "es"
    ? "Desarrollador Full Stack - Alexander Valverde"
    : "Full Stack Developer - Alexander Valverde";

const ogImage = toAbsoluteUrl("/og-image-es.png", Astro.site);
const ogLocale = lang === "es" ? "es_ES" : "en_US";

const alternatePathnames = alternateLocales
  ? getAlternatePathnames(canonicalPathname)
  : null;
const esAlternateUrl = alternatePathnames
  ? toAbsoluteUrl(alternatePathnames.es, Astro.site)
  : null;
const enAlternateUrl = alternatePathnames
  ? toAbsoluteUrl(alternatePathnames.en, Astro.site)
  : null;

const personJsonLd = includeJsonLd ? getPersonJsonLd(lang, Astro.site) : null;
---

<!-- Meta Tags esenciales -->
<title>{cleanTitle}</title>
<meta name="description" content={cleanDescription} />
<meta name="keywords" content={keywords} />
<link rel="canonical" href={canonicalURL} />

{
  alternatePathnames && (
    <>
      <link rel="alternate" hreflang="es" href={esAlternateUrl} />
      <link rel="alternate" hreflang="en" href={enAlternateUrl} />
      <link rel="alternate" hreflang="x-default" href={esAlternateUrl} />
    </>
  )
}

<!-- Noindex y Nofollow Condicional -->
{noindex && <meta name="robots" content="noindex" />}
{nofollow && <meta name="robots" content="nofollow" />}

<!-- Open Graph para Redes Sociales -->
<meta property="og:title" content={cleanTitle} />
<meta property="og:description" content={cleanDescription} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImage} />
<meta property="og:type" content="website" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:image:alt" content={imageAltText} />

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={cleanTitle} />
<meta name="twitter:description" content={cleanDescription} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAltText} />

{
  personJsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  )
}

<!-- Favicon y precarga de recursos críticos -->
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="57x57" href="/apple-icon-57x57.png" />
<link rel="apple-touch-icon" sizes="60x60" href="/apple-icon-60x60.png" />
<link rel="apple-touch-icon" sizes="72x72" href="/apple-icon-72x72.png" />
<link rel="apple-touch-icon" sizes="76x76" href="/apple-icon-76x76.png" />
<link rel="apple-touch-icon" sizes="114x114" href="/apple-icon-114x114.png" />
<link rel="apple-touch-icon" sizes="120x120" href="/apple-icon-120x120.png" />
<link rel="apple-touch-icon" sizes="144x144" href="/apple-icon-144x144.png" />
<link rel="apple-touch-icon" sizes="152x152" href="/apple-icon-152x152.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-icon-180x180.png" />
<link
  rel="icon"
  type="image/png"
  sizes="192x192"
  href="/android-icon-192x192.png"
/>
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />

<!-- Meta para la accesibilidad y rendimiento -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
